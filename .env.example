# Bun loads .env automatically. Credentials never go to the browser.
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1/
MUBIT_API_KEY=
# Set the actual model/route IDs provided by your gateway.
MUBIT_MODEL=
FRONTIER_MODEL=
# Optional separate endpoint for the frontier comparison.
# Defaults to the Mubit URL/key if omitted (a model comparison through one gateway).
FRONTIER_BASE_URL=
FRONTIER_API_KEY=
# Optional extra JSON body fields for documented gateway-specific routing.
# Learning/training is NOT assumed or enabled without your gateway's contract.
MUBIT_EXTRA_BODY={}
PORT=3000
# Optional legacy step-by-step controller for comparison only.
ENABLE_STEP_MODE=0

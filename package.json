{
  "name": "latte-bench",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.js",
    "start": "bun server.js",
    "build": "bun build src/main.js --outdir dist/src --minify && cp index.html dist/index.html && cp src/style.css dist/src/style.css",
    "test": "bun test",
    "bench": "bun scripts/bench.js",
    "verify": "bun scripts/verify.js",
    "baseline": "uv run scripts/optimize.py",
    "calibrate": "uv run scripts/calibrate.py",
    "report": "bun scripts/report.js"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
